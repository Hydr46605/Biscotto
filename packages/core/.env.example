DISCORD_TOKEN=your-bot-token-here
DISCORD_CLIENT_ID=your-client-id-here
DISCORD_GUILD_ID=your-guild-id-here

# Storage: json | sqlite | yaml | mysql
STORAGE_DRIVER=json
STORAGE_JSON_PATH=./data/store.json
STORAGE_SQLITE_PATH=./data/store.db
STORAGE_YAML_PATH=./data/store.yaml

# MySQL (only if STORAGE_DRIVER=mysql)
