{
  "name": "biscotto",
  "version": "1.0.0",
  "private": true,
  "description": "Modular Discord bot framework",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=@biscotto/core",
